def load_state():
    """Read and validate the block state. None when there is no valid block."""
    try:
        with open(STATE, encoding="utf-8") as fh:
            raw = json.load(fh)
        domains = []
        for d in raw["domains"][:MAX_DOMAINS]:
            try:
                domains.append(normalize_domain(str(d)))
            except ValueError:
                pass
        state = {
            "version": 1,
            "domains": sorted(set(domains)),
            "labels": [str(x)[:60] for x in raw.get("labels", [])][:50],
            "duration": float(raw["duration"]),
            "remaining": float(raw["remaining"]),
            "started_wall": float(raw["started_wall"]),
            "end_wall": float(raw["end_wall"]),
            "boot_id": str(raw.get("boot_id", "")),
            "last_boottime": float(raw.get("last_boottime", 0)),
        }
        if not state["domains"] or state["duration"] <= 0:
            return None
        state["remaining"] = min(state["remaining"], state["duration"], MAX_SECONDS * 2)
        return state
    except (OSError, ValueError, KeyError, TypeError):
        return None


def save_state(state):
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    set_immutable(STATE, False)
    atomic_write(STATE, json.dumps(state, indent=1, sort_keys=True) + "\n")
    set_immutable(STATE, True)


def account(state):
    """Charge elapsed uptime against the countdown. Returns True when over.

    Time only counts while this boot is running (suspend included). Time
    spent powered off is credited only through the wall clock, and only when
    the kernel reports that clock as NTP-synchronised.
    """
    now = boottime()
    current_boot = boot_id()
    if state.get("boot_id") == current_boot:
        elapsed = now - state["last_boottime"]
        if elapsed > 0:
            state["remaining"] -= elapsed
    state["boot_id"] = current_boot
    state["last_boottime"] = now
    if state["remaining"] <= 0:
        return True
    return clock_synced() and time.time() >= state["end_wall"]


def remaining_now(state):
    """Best estimate of the seconds left, without modifying anything."""
    left = state["remaining"]
    if state.get("boot_id") == boot_id():
        left -= max(0, boottime() - state["last_boottime"])
    if clock_synced():
        left = min(left, state["end_wall"] - time.time())
    return max(0, left)


