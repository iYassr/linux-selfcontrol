_LABEL_RE = re.compile(r"^(?!-)[a-z0-9-]{1,63}(?<!-)$")
_LISTNAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,39}$")
_RESERVED_SUFFIXES = (".localhost", ".local", ".lan", ".internal", ".localdomain",
                      ".home.arpa", ".test", ".invalid", ".example")
ALLOWLIST = "allowlist"


def normalize_domain(raw):
    """Turn user input (domain or URL) into a safe bare hostname.

    Raises ValueError for anything that is not a plain public hostname. This
    is the only gate between user input and /etc/hosts, so it is strict.
    """
    s = raw.strip().lower()
    if "://" in s:
        s = s.split("://", 1)[1]
    for sep in "/?#":
        s = s.split(sep, 1)[0]
    if "@" in s:
        s = s.rsplit("@", 1)[1]
    if s.count(":") == 1:
        s = s.split(":", 1)[0]
    if s.startswith("*."):
        s = s[2:]
    s = s.strip(".")
    if not s:
        raise ValueError("empty hostname")
    try:
        s.encode("ascii")
    except UnicodeError:
        try:
            s = s.encode("idna").decode("ascii")
        except UnicodeError:
            raise ValueError("invalid hostname %r" % raw)
    labels = s.split(".")
    if len(s) > 253 or len(labels) < 2 or not all(_LABEL_RE.match(x) for x in labels):
        raise ValueError("invalid hostname %r" % raw)
    if labels[-1].isdigit():
        raise ValueError("%r is an IP address, not a hostname" % raw)
    if s.endswith(_RESERVED_SUFFIXES) or s == socket.gethostname().lower():
        raise ValueError("refusing to block local name %r" % raw)
    return s


def invoking_home():
    """Home of the human running the command, even under sudo."""
    user = os.environ.get("SUDO_USER") if os.geteuid() == 0 else None
    if user and user != "root":
        try:
            return pwd.getpwnam(user).pw_dir
        except KeyError:
            pass
    return os.path.expanduser("~")


def config_dir():
    if os.environ.get("SELFCTL_CONFIG"):
        return os.environ["SELFCTL_CONFIG"]
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg and os.geteuid() != 0:
        return os.path.join(xdg, "selfctl")
    return os.path.join(invoking_home(), ".config", "selfctl")


def user_lists_dir():
    return os.path.join(config_dir(), "lists")


def builtin_lists_dir():
    here = os.path.dirname(SELF)
    candidates = [
        os.environ.get("SELFCTL_LISTS", ""),
        os.path.join(here, "lists"),
        os.path.join(os.path.dirname(here), "share", "linux-selfcontrol", "lists"),
        "/usr/share/linux-selfcontrol/lists",
        "/usr/local/share/linux-selfcontrol/lists",
    ]
    for d in candidates:
        if d and os.path.isdir(d):
            return d
    return candidates[1]


def _is_ip(token):
    for family in (socket.AF_INET, socket.AF_INET6):
        try:
            socket.inet_pton(family, token)
            return True
        except (OSError, ValueError):
            pass
    return False


def parse_list_file(path):
    """Return (meta, domains, problems) for one list file."""
    meta, domains, problems, seen = {}, [], [], set()
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError as e:
        return meta, domains, ["cannot read %s: %s" % (path, e.strerror)]
    for no, line in enumerate(lines, 1):
        stripped = line.strip()
        if stripped.startswith("#"):
            m = re.match(r"#\s*(title|description)\s*:\s*(.+)", stripped, re.I)
            if m and m.group(1).lower() not in meta:
                meta[m.group(1).lower()] = m.group(2).strip()
            continue
        body = stripped.split("#", 1)[0].split()
        # accept hosts-file syntax too: "0.0.0.0 example.com"
        if len(body) >= 2 and _is_ip(body[0]):
            body = body[1:]
        for token in body:
            try:
                d = normalize_domain(token)
            except ValueError as e:
                problems.append("%s:%d: %s" % (os.path.basename(path), no, e))
                continue
            if d not in seen:
                seen.add(d)
                domains.append(d)
    return meta, domains, problems


def available_lists():
    """name -> {path, source, title, description, domains, problems}."""
    found = {}
    for source, d in (("built-in", builtin_lists_dir()), ("custom", user_lists_dir())):
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in names:
            if not fn.endswith(".txt"):
                continue
            name = fn[:-4]
            if not _LISTNAME_RE.match(name) or name == ALLOWLIST:
                continue
            path = os.path.join(d, fn)
            meta, domains, problems = parse_list_file(path)
            if source == "custom" and name in found:
                source_label = "customised"
            else:
                source_label = source
            found[name] = {
                "name": name, "path": path, "source": source_label,
                "title": meta.get("title", name.capitalize()),
                "description": meta.get("description", ""),
                "domains": domains, "problems": problems,
            }
    return found


def load_allowlist():
    path = os.path.join(user_lists_dir(), ALLOWLIST + ".txt")
    if not os.path.isfile(path):
        return []
    return parse_list_file(path)[1]


def expand_domains(domains, allow=()):
    """Add the www. twin of every name and drop anything on the allowlist."""
    out = set()
    for d in domains:
        out.add(d)
        if not d.startswith("www."):
            out.add("www." + d)
    allow = set(allow)
    if allow:
        def allowed(name):
            parts = name.split(".")
            return any(".".join(parts[i:]) in allow for i in range(len(parts) - 1))
        out = set(d for d in out if not allowed(d))
    return sorted(out)


def resolve_targets(tokens):
    """Split CLI tokens into (list names, extra domains, final hostnames)."""
    lists = available_lists()
    names, extra, base = [], [], []
    for tok in tokens:
        key = tok.strip().lower()
        if key in lists:
            names.append(key)
            base.extend(lists[key]["domains"])
        elif "." in key:
            try:
                d = normalize_domain(key)
            except ValueError as e:
                die(str(e))
            extra.append(d)
            base.append(d)
        else:
            die("unknown list %r. Run 'selfctl lists' to see what is available, "
                "or pass a domain such as example.com." % tok)
    return names, extra, expand_domains(base, load_allowlist())


