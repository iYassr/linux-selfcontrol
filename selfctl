def die(message, code=1):
    sys.stderr.write(red("error: ") + message + "\n")
    sys.exit(code)


def fmt_duration(seconds):
    seconds = max(0, int(round(seconds)))
    d, rem = divmod(seconds, 86400)
    h, rem = divmod(rem, 3600)
    m, s = divmod(rem, 60)
    parts = []
    if d:
        parts.append("%dd" % d)
    if h:
        parts.append("%dh" % h)
    if m:
        parts.append("%dm" % m)
    if s and not d:
        parts.append("%ds" % s)
    return " ".join(parts) or "0s"


_DURATION_RE = re.compile(r"(\d+(?:\.\d+)?)\s*([dhms]?)")


def parse_duration(text):
    """'90m', '2h', '1h30m', '1d', '45' (minutes), '30s' -> seconds."""
    s = text.strip().lower().replace(" ", "")
    if not s:
        raise ValueError("empty duration")
    pos, total = 0, 0.0
    for m in _DURATION_RE.finditer(s):
        if m.start() != pos:
            raise ValueError("cannot understand duration %r" % text)
        pos = m.end()
        unit = m.group(2) or "m"
        total += float(m.group(1)) * {"d": 86400, "h": 3600, "m": 60, "s": 1}[unit]
    if pos != len(s):
        raise ValueError("cannot understand duration %r (try 45m, 2h, 1h30m, 1d)" % text)
    total = int(round(total))
    if total < MIN_SECONDS:
        raise ValueError("duration must be at least %d seconds" % MIN_SECONDS)
    if total > MAX_SECONDS:
        raise ValueError("duration cannot exceed %s" % fmt_duration(MAX_SECONDS))
    return total


