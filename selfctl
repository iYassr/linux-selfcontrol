def protection_report(state):
    """What is actually guarding the block right now."""
    hosts_ok = compose_hosts(read_hosts(), state["domains"]) == read_hosts()
    report = [("hosts file", hosts_ok), ("locked", bool(get_immutable(HOSTS)))]
    if has_systemd():
        report.append(("daemon", run(["systemctl", "is-active", "--quiet", SERVICE]) == 0))
        report.append(("watchdog", run(["systemctl", "is-active", "--quiet", TIMER]) == 0))
    return report


def progress_bar(fraction, width=30):
    filled = int(round(max(0.0, min(1.0, fraction)) * width))
    return c("36", "█" * filled) + dim("░" * (width - filled))


def visible_count(state):
    """Hostnames the user asked for (the DoH helper entries are not counted)."""
    return len(set(state["domains"]) - set(DOH_HOSTS)) or len(state["domains"])


def status_lines(state, report=None):
    if state is None:
        return [
            "",
            "  " + green("○") + bold(" No block is active"),
            "",
            "  " + dim("Start one:  ") + "selfctl start 1h social",
            "  " + dim("Or just run ") + "selfctl" + dim(" for the guided menu."),
            "",
        ]
    left = remaining_now(state)
    done = 1 - left / state["duration"] if state["duration"] else 1
    ends = time.strftime("%a %H:%M", time.localtime(time.time() + left))
    labels = ", ".join(state["labels"]) or "custom sites"
    lines = [
        "",
        "  " + red("●") + bold(" Block is ACTIVE"),
        "",
        "  " + bold(fmt_duration(left)) + " remaining" + dim("   ends ≈ " + ends),
        "  " + progress_bar(done) + dim("  %d%%" % int(done * 100)),
        "",
        "  " + dim("blocking  ") + "%d hostnames" % visible_count(state),
        "  " + dim("lists     ") + labels,
    ]
    if report:
        marks = "  ".join((green("✔ ") if ok else red("✘ ")) + name for name, ok in report)
        lines.append("  " + dim("guards    ") + marks)
    lines.append("")
    return lines


def cmd_status(args):
    state = load_state()
    if "--json" in args:
        out = {"active": state is not None, "version": VERSION}
        if state:
            left = remaining_now(state)
            out.update(remaining_seconds=int(left), duration_seconds=int(state["duration"]),
                       ends_at=int(time.time() + left), hostnames=visible_count(state),
                       lists=state["labels"])
        print(json.dumps(out))
    elif "--short" in args:
        # for status bars: empty when idle
        if state:
            print("🔒 " + fmt_duration(remaining_now(state)))
    else:
        print("\n".join(status_lines(state, protection_report(state) if state else None)))
    return 0


