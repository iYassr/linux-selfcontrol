def elevate(request):
    """Run apply_request as root, asking for a password if needed."""
    if os.geteuid() == 0 or SANDBOX:
        return apply_request(request) and 0
    payload = json.dumps(request)
    if shutil.which("sudo") and (sys.stdin.isatty() or run(["sudo", "-n", "true"]) == 0):
        prefix = ["sudo", "--"]
    elif shutil.which("pkexec"):
        prefix = ["pkexec"]
    elif shutil.which("sudo"):
        prefix = ["sudo", "--"]
    elif shutil.which("doas"):
        prefix = ["doas"]
    else:
        die("need root: run this command with sudo")
    try:
        proc = subprocess.run(prefix + [SELF, "_apply"], input=payload.encode())
    except KeyboardInterrupt:
        die("cancelled")
    return proc.returncode


