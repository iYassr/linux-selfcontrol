[Timer]
OnBootSec=15s
OnUnitActiveSec=45s
AccuracySec=5s

[Install]
WantedBy=timers.target
""" % {"url": PROJECT_URL},
    }


def _read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeError):
        return None


def enforce_units():
    """Keep the service and watchdog installed, unmasked, enabled and running."""
    if not has_systemd():
        return
    reload_needed = False
    for name, text in unit_texts().items():
        path = os.path.join(UNIT_DIR, name)
        dropin = path + ".d"
        if os.path.isdir(dropin):
            shutil.rmtree(dropin, ignore_errors=True)
            reload_needed = True
        if os.path.islink(path) or _read(path) != text:
            set_immutable(path, False)
            try:
                os.unlink(path)
            except OSError:
                pass
            atomic_write(path, text)
            reload_needed = True
        if get_immutable(path) is False:
            set_immutable(path, True)
    if reload_needed:
        run(["systemctl", "daemon-reload"], 30)
    wants = (("multi-user.target.wants", SERVICE), ("timers.target.wants", TIMER))
    for directory, name in wants:
        if not os.path.islink(os.path.join(UNIT_DIR, directory, name)):
            run(["systemctl", "enable", name])
    if run(["systemctl", "is-active", "--quiet", TIMER]) != 0:
        run(["systemctl", "start", TIMER])


def remove_units():
    if not has_systemd():
        return
    run(["systemctl", "disable", "--now", TIMER])
    run(["systemctl", "disable", SERVICE])
    for name in unit_texts():
        path = os.path.join(UNIT_DIR, name)
        set_immutable(path, False)
        try:
            os.unlink(path)
        except OSError:
            pass
    run(["systemctl", "daemon-reload"], 30)


def enforce_browser_policies():
    """Switch off DNS-over-HTTPS in installed browsers for the block."""
    if SANDBOX:
        return
    for binary, directory in CHROMIUM_POLICY_DIRS.items():
        if not shutil.which(binary):
            continue
        path = os.path.join(directory, CHROMIUM_POLICY_NAME)
        if _read(path) != CHROMIUM_POLICY:
            try:
                os.makedirs(directory, mode=0o755, exist_ok=True)
                atomic_write(path, CHROMIUM_POLICY)
            except OSError:
                pass
    if any(shutil.which(b) for b in FIREFOX_BINARIES):
        # Firefox reads a single policies.json; never touch someone else's.
        if not os.path.exists(FIREFOX_POLICY_PATH):
            try:
                os.makedirs(os.path.dirname(FIREFOX_POLICY_PATH), mode=0o755, exist_ok=True)
                atomic_write(FIREFOX_POLICY_PATH, FIREFOX_POLICY)
            except OSError:
                pass


def remove_browser_policies():
    if SANDBOX:
        return
    for directory in set(CHROMIUM_POLICY_DIRS.values()):
        path = os.path.join(directory, CHROMIUM_POLICY_NAME)
        if _read(path) == CHROMIUM_POLICY:
            try:
                os.unlink(path)
            except OSError:
                pass
    if _read(FIREFOX_POLICY_PATH) == FIREFOX_POLICY:
        try:
            os.unlink(FIREFOX_POLICY_PATH)
        except OSError:
            pass


# --------------------------------------------------------------------------
# Block lifecycle (root only)
# --------------------------------------------------------------------------

def enforce_all(state, slow=True):
    enforce_hosts(state["domains"])
    if slow:
        enforce_units()
        enforce_browser_policies()


def finish():
    """End the block and put the system back exactly as it was."""
    current = read_hosts()
    clean = strip_managed(current)
    set_immutable(HOSTS, False)
    if clean != current:
        write_hosts(clean, False)
    remove_browser_policies()
    set_immutable(STATE, False)
    for path in (STATE, HOSTS_BACKUP):
        try:
            os.unlink(path)
        except OSError:
            pass
    flush_dns()
    remove_units()


def self_is_trustworthy():
    """The daemon runs this file as root at boot: it must be root-owned."""
    for path in (SELF, os.path.dirname(SELF)):
        st = os.stat(path)
        if st.st_uid != 0 or st.st_mode & 0o022:
            return False
    return True


def spawn_detached_daemon():
    """Fallback for systems without systemd."""
    if os.fork():
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    os.execv(SELF, [SELF, "_daemon"])


def apply_request(req):
    """Privileged entry point. `req` comes from an unprivileged caller and is
    validated from scratch. A request can only ever make a block stricter."""
    if os.geteuid() != 0 and not SANDBOX:
        die("this step needs root")
    action = req.get("action")
    if action not in ("start", "add", "extend"):
        die("bad request")
    try:
        seconds = int(req.get("seconds", 0))
        domains = sorted(set(normalize_domain(str(d)) for d in req.get("domains", [])))
    except (ValueError, TypeError) as e:
        die("bad request: %s" % e)
    if len(domains) > MAX_DOMAINS:
        die("too many hostnames (limit %d)" % MAX_DOMAINS)
    labels = [str(x)[:60] for x in req.get("labels", []) if isinstance(x, str)][:50]

    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    with locked(STATE_LOCK):
        state = load_state()
        if state is not None and account(state):
            finish()
            state = None

        if action == "start":
            if state is not None:
                die("a block is already active (%s left). Use 'selfctl add' or "
                    "'selfctl extend' to make it stricter." % fmt_duration(remaining_now(state)))
            if not domains:
                die("nothing to block")
            if not MIN_SECONDS <= seconds <= MAX_SECONDS:
                die("duration out of range")
            if has_systemd() and not self_is_trustworthy():
                die("%s is not installed as a root-owned file.\n"
                    "Install it first:  sudo ./install.sh" % SELF)
            if os.path.islink(HOSTS) and not os.access(os.path.realpath(HOSTS), os.W_OK):
                die("%s is a read-only link on this system; selfctl cannot manage it" % HOSTS)
            try:
                shutil.copyfile(HOSTS, HOSTS_BACKUP)
            except OSError:
                pass
            now = time.time()
            state = {
                "version": 1,
                "domains": sorted(set(domains) | set(DOH_HOSTS)),
                "labels": labels, "duration": float(seconds), "remaining": float(seconds),
                "started_wall": now, "end_wall": now + seconds,
                "boot_id": boot_id(), "last_boottime": boottime(),
            }
        else:
            if state is None:
                die("no block is active. Start one with 'selfctl start'.")
            if action == "add":
                if not domains:
                    die("nothing to add")
                state["domains"] = sorted(set(state["domains"]) | set(domains))
                state["labels"] = list(dict.fromkeys(state["labels"] + labels))[:50]
            else:
                if seconds < 1:
                    die("nothing to extend by")
                if remaining_now(state) + seconds > MAX_SECONDS:
                    die("a block cannot run longer than %s" % fmt_duration(MAX_SECONDS))
                state["duration"] += seconds
                state["remaining"] += seconds
                state["end_wall"] += seconds
        save_state(state)
        enforce_all(state)

    if has_systemd():
        if run(["systemctl", "start", SERVICE]) != 0:
            sys.stderr.write(yellow("warning: ") + "could not start %s; the watchdog "
                             "timer will retry.\n" % SERVICE)
    elif not SANDBOX:
        spawn_detached_daemon()
    return state


def cmd_daemon():
    if os.geteuid() != 0 and not SANDBOX:
        die("the daemon must run as root")
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    guard = locked(DAEMON_LOCK, blocking=False)
    try:
        guard.__enter__()
    except OSError:
        return 0                      # another daemon is already on duty
    stopping = []
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    signal.signal(signal.SIGINT, lambda *_: stopping.append(1))
    signal.signal(signal.SIGHUP, signal.SIG_IGN)

    with locked(STATE_LOCK):
        mem = load_state()
    if mem is None:
        with locked(STATE_LOCK):
            finish()
        return 0

    last_save = last_slow = 0.0
    last_raw = _read(STATE)
    while True:
        with locked(STATE_LOCK):
            raw = _read(STATE)
            dirty = raw != last_raw                     # edited, deleted or extended
            disk = load_state() if dirty else None
            if disk is not None:
                # The file on disk is how 'add' and 'extend' reach us. Only
                # ever accept changes that make the block stricter.
                merged = sorted(set(mem["domains"]) | set(disk["domains"]))
                if merged != mem["domains"]:
                    mem["domains"] = merged
                    mem["labels"] = list(dict.fromkeys(mem["labels"] + disk["labels"]))[:50]
                extra = disk["duration"] - mem["duration"]
                if extra > 0:
                    mem["duration"] += extra
                    mem["remaining"] += extra
                    mem["end_wall"] += extra
            over = account(mem)
            now = boottime()
            if over:
                finish()
                return 0
            if stopping:
                save_state(mem)
                return 1              # non-zero so systemd restarts us
            slow = now - last_slow >= SLOW_EVERY
            try:
                enforce_all(mem, slow)
                if dirty or now - last_save >= SAVE_EVERY:
                    save_state(mem)
                    last_save, last_raw = now, _read(STATE)
            except OSError as e:
                sys.stderr.write("selfctl: enforcement problem: %s\n" % e)
            if slow:
                last_slow = now
        time.sleep(TICK if not SANDBOX else float(os.environ.get("SELFCTL_TICK", "0.1")))


def cmd_watchdog():
    """Runs from the timer. Revives the daemon, or enforces in its place."""
    if os.geteuid() != 0 and not SANDBOX:
        die("the watchdog must run as root")
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    try:
        with locked(DAEMON_LOCK, blocking=False):
            with locked(STATE_LOCK):
                state = load_state()
                if state is None or account(state):
                    finish()
                    return 0
                enforce_all(state)
                save_state(state)
    except OSError as e:
        if e.errno not in (errno.EAGAIN, errno.EACCES):
            raise
        return 0                      # daemon holds the lock: all is well
    if has_systemd():
        run(["systemctl", "start", SERVICE])
    return 0


