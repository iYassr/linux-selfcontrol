def start_block(duration_text, tokens, assume_yes):
    try:
        seconds = parse_duration(duration_text)
    except ValueError as e:
        die(str(e))
    names, extra, hostnames = resolve_targets(tokens)
    if not hostnames:
        die("nothing to block (everything selected is on your allowlist?)")
    state = load_state()
    if state is not None and remaining_now(state) > 0:
        die("a block is already active (%s left). Use 'selfctl add' or 'selfctl extend'."
            % fmt_duration(remaining_now(state)))
    if not assume_yes:
        print("\n".join(confirm_lines(names, extra, hostnames, seconds)))
        if not sys.stdin.isatty():
            die("refusing to start without confirmation; pass --yes")
        if ask("Start the block? [y/N] ").lower() not in ("y", "yes"):
            print("  Cancelled. Nothing was changed.")
            return 1
    labels = names + (["%d custom" % len(extra)] if extra else [])
    code = elevate({"action": "start", "seconds": seconds, "domains": hostnames,
                    "labels": labels})
    if code == 0:
        save_last(names, duration_text)
        cmd_status([])
        print("  " + dim("Tip: restart your browser so it drops cached connections."))
        print()
    return code


def cmd_start(args):
    assume_yes = False
    rest = []
    for a in args:
        if a in ("-y", "--yes"):
            assume_yes = True
        elif a.startswith("-"):
            die("unknown option %s" % a)
        else:
            rest.append(a)
    if not rest:
        die("usage: selfctl start <duration> [list|domain ...]\n"
            "       e.g. selfctl start 2h social video reddit.com")
    tokens = rest[1:] or load_last()[0]
    return start_block(rest[0], tokens, assume_yes)


def cmd_add(args):
    if not args:
        die("usage: selfctl add <list|domain> ...")
    if load_state() is None:
        die("no block is active. Start one with 'selfctl start'.")
    names, extra, hostnames = resolve_targets(args)
    labels = names + (["%d custom" % len(extra)] if extra else [])
    code = elevate({"action": "add", "domains": hostnames, "labels": labels})
    if code == 0:
        print("  " + green("✔") + " Added %d hostnames to the active block." % len(hostnames))
    return code


def cmd_extend(args):
    if len(args) != 1:
        die("usage: selfctl extend <duration>   e.g. selfctl extend 30m")
    if load_state() is None:
        die("no block is active. Start one with 'selfctl start'.")
    try:
        seconds = parse_duration(args[0])
    except ValueError as e:
        die(str(e))
    code = elevate({"action": "extend", "seconds": seconds})
    if code == 0:
        state = load_state()
        print("  " + green("✔") + " Extended by %s. %s left." % (
            fmt_duration(seconds), fmt_duration(remaining_now(state) if state else 0)))
    return code


LIST_TEMPLATE = """# title: %s
# description: My own list
#
# One site per line. Lines starting with # are ignored.
# "www." is added automatically; other subdomains must be listed.

"""

ALLOW_TEMPLATE = """# Sites listed here are never blocked, even if a list contains them.
# One site per line. A site also covers its subdomains.

"""


def open_editor(path):
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR")
    for candidate in ([editor] if editor else []) + ["nano", "vim", "vi"]:
        argv = candidate.split()
        if argv and shutil.which(argv[0]):
            return subprocess.call(argv + [path])
    print("  No editor found. Edit this file by hand:\n  " + path)
    return 0


def cmd_lists(args):
    lists = available_lists()
    sub = args[0] if args else "show-all"
    name = args[1].lower() if len(args) > 1 else None

    if sub == "show-all":
        print()
        print("  " + bold("%-11s %-26s %6s  %s" % ("LIST", "WHAT", "SITES", "SOURCE")))
        for n in sorted(lists):
            item = lists[n]
            print("  %s %-26s %6d  %s" % (cyan("%-11s" % n), item["title"][:26],
                                          len(item["domains"]), dim(item["source"])))
        allow = load_allowlist()
        print()
        if allow:
            print("  " + dim("allowlist: %d sites are never blocked" % len(allow)))
        print("  " + dim("selfctl lists show NAME · edit NAME · new NAME · reset NAME · edit allowlist"))
        print()
        return 0

    if sub in ("show", "edit", "new", "reset", "rm", "remove") and not name:
        die("usage: selfctl lists %s NAME" % sub)

    if sub == "show":
        if name == ALLOWLIST:
            print("\n".join(load_allowlist()))
            return 0
        if name not in lists:
            die("no list called %r" % name)
        for problem in lists[name]["problems"]:
            sys.stderr.write(yellow("warning: ") + problem + "\n")
        print("\n".join(lists[name]["domains"]))
        return 0

    if sub in ("edit", "new"):
        if os.geteuid() == 0 and not os.environ.get("SUDO_USER"):
            die("edit lists as your normal user, not as root")
        if not _LISTNAME_RE.match(name):
            die("list names use lowercase letters, digits, - and _")
        if sub == "new" and name in lists:
            die("a list called %r already exists; use 'selfctl lists edit %s'" % (name, name))
        if sub == "edit" and name not in lists and name != ALLOWLIST:
            die("no list called %r; create it with 'selfctl lists new %s'" % (name, name))
        os.makedirs(user_lists_dir(), exist_ok=True)
        target = os.path.join(user_lists_dir(), name + ".txt")
        if not os.path.exists(target):
            if name == ALLOWLIST:
                content = ALLOW_TEMPLATE
            elif name in lists:
                with open(lists[name]["path"], encoding="utf-8") as fh:
                    content = fh.read()
            else:
                content = LIST_TEMPLATE % name.capitalize()
            with open(target, "w", encoding="utf-8") as fh:
                fh.write(content)
        code = open_editor(target)
        _, domains, problems = parse_list_file(target)
        for problem in problems:
            sys.stderr.write(yellow("warning: ") + problem + "\n")
        print("  " + green("✔") + " %s: %d sites  " % (name, len(domains)) + dim(target))
        if load_state() is not None:
            print("  " + dim("The running block is unchanged; use 'selfctl add %s' to add "
                             "new sites to it." % name))
        return code

    if sub in ("reset", "rm", "remove"):
        target = os.path.join(user_lists_dir(), name + ".txt")
        if not os.path.exists(target):
            die("%r has no custom version to remove" % name)
        os.unlink(target)
        print("  " + green("✔") + " Removed your version of %r." % name)
        return 0

    die("unknown lists command %r (try: show, edit, new, reset)" % sub)


BLOCKED_ADDRESSES = ("0.0.0.0", "::", "127.0.0.1", "::1")


def lookup(host):
    try:
        infos = socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
    except (socket.gaierror, UnicodeError):
        return []
    return sorted(set(i[4][0] for i in infos))


def cmd_check(args):
    if not args:
        die("usage: selfctl check <domain> ...")
    worst = 0
    state = load_state()
    mine = set(state["domains"]) if state else set()
    print()
    for raw in args:
        try:
            host = normalize_domain(raw)
        except ValueError as e:
            die(str(e))
        addrs = lookup(host)
        if addrs and all(a in BLOCKED_ADDRESSES for a in addrs):
            note = "" if host in mine else dim("  (not by selfctl: your DNS or another tool)")
            print("  " + red("● blocked ") + " " + host + note)
        elif addrs:
            print("  " + green("○ reachable") + " " + host + dim("  → " + ", ".join(addrs[:3])))
            worst = 1
        else:
            print("  " + yellow("? no answer") + " " + host + dim("  (offline, or it does not exist)"))
    print()
    return worst


def cmd_doctor(_args):
    ok_all = [True]

    def row(ok, label, detail=""):
        mark = green("✔") if ok is True else (red("✘") if ok is False else yellow("!"))
        if ok is False:
            ok_all[0] = False
        print("  %s %-34s %s" % (mark, label, dim(detail)))

    print()
    print("  " + bold("selfctl doctor") + dim("  v" + VERSION))
    print()
    row(sys.version_info >= (3, 6), "Python %d.%d" % sys.version_info[:2])
    if has_systemd():
        row(True, "systemd found", "daemon and watchdog available")
    else:
        row(None, "no systemd", "blocks work, but do not resume after a reboot")
    try:
        trusted = self_is_trustworthy()
    except OSError:
        trusted = False
    row(trusted if has_systemd() else True, "installed as root-owned file", SELF)
    real = os.path.realpath(HOSTS)
    row(os.path.isfile(real), "hosts file", real + (" (via symlink)" if real != HOSTS else ""))
    try:
        nss = _p("/etc/nsswitch.conf")
        with open(nss if os.path.exists(nss) else _p("/usr/etc/nsswitch.conf")) as fh:
            line = [x for x in fh.read().splitlines() if x.strip().startswith("hosts:")]
        uses = bool(line) and bool(re.search(r"\b(files|resolve)\b", line[0]))
        row(uses, "resolver reads /etc/hosts", line[0].strip() if line else "no hosts: line")
    except OSError:
        row(None, "resolver reads /etc/hosts", "no nsswitch.conf (musl?) - hosts is used by default")
    if os.geteuid() == 0:
        probe = os.path.join(os.path.dirname(real), ".selfctl-probe")
        try:
            with open(probe, "w") as fh:
                fh.write("x")
            locked_ok = set_immutable(probe, True) and get_immutable(probe)
            set_immutable(probe, False)
            os.unlink(probe)
            if locked_ok:
                row(True, "immutable flag supported", "hosts file can be locked")
            else:
                row(None, "immutable flag not supported", "daemon still reverts edits within 2s")
        except OSError as e:
            row(False, "can write next to hosts file", e.strerror)
    else:
        row(None, "immutable flag", "run 'sudo selfctl doctor' to test")
    row(True if clock_synced() else None, "clock synchronised (NTP)",
        "" if clock_synced() else "time spent powered off will not count down")
    lists = available_lists()
    row(bool(lists), "block lists", "%d lists in %s" % (len(lists), builtin_lists_dir()))
    browsers = [b for b in list(CHROMIUM_POLICY_DIRS) + list(FIREFOX_BINARIES) if shutil.which(b)]
    row(True, "browsers", ", ".join(browsers) + " (encrypted DNS is turned off during a block)"
        if browsers else "none of the known ones found")
    state = load_state()
    if state:
        sample = [d for d in state["domains"] if d not in DOH_HOSTS][:1] or state["domains"][:1]
        addrs = lookup(sample[0])
        row(bool(addrs) and all(a in BLOCKED_ADDRESSES for a in addrs),
            "active block resolves as blocked", "%s → %s" % (sample[0], ", ".join(addrs) or "nothing"))
    print()
    return 0 if ok_all[0] else 1


HELP = """%(title)s  v%(version)s
Block distracting websites for a set time. There is no stop button.

%(usage)s
  selfctl                          guided menu
  selfctl start <time> [what...]   start a block
  selfctl status                   time left and what is blocked
  selfctl add <what...>            block more sites during a block
  selfctl extend <time>            make a running block longer
  selfctl lists                    show the ready-made and custom lists
  selfctl lists edit <name>        customise a list (or 'allowlist')
  selfctl lists new <name>         create your own list
  selfctl check <domain...>        is this site blocked right now?
  selfctl doctor                   check that this system is supported

%(examples)s
  selfctl start 2h social video
  selfctl start 45m reddit.com news.ycombinator.com
  selfctl start 1h30m social -y    skip the confirmation question

  <time> is like 25m, 2h, 1h30m or 1d.  <what> is a list name or a domain.
  status also takes --json and --short (for status bars).

%(url)s
"""


def cmd_help():
    print(HELP % {"title": bold("Linux SelfControl"), "version": VERSION,
                  "usage": bold("Usage"), "examples": bold("Examples"),
                  "url": dim(PROJECT_URL)})
    return 0


def main(argv):
    if not argv:
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            return cmd_help()
        state = load_state()
        if state is not None and remaining_now(state) > 0:
            return interactive_active(state)
        return interactive_start()
    cmd, args = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        return cmd_help()
    if cmd in ("-V", "--version", "version"):
        print("selfctl " + VERSION)
        return 0
    if cmd == "_apply":
        try:
            request = json.loads(sys.stdin.read(8 * 1024 * 1024))
        except ValueError:
            die("bad request")
        if not isinstance(request, dict):
            die("bad request")
        apply_request(request)
        return 0
    if cmd == "_daemon":
        return cmd_daemon()
    if cmd == "_watchdog":
        return cmd_watchdog()
    commands = {"start": cmd_start, "status": cmd_status, "add": cmd_add,
                "extend": cmd_extend, "lists": cmd_lists, "list": cmd_lists,
                "check": cmd_check, "doctor": cmd_doctor}
    if cmd in ("stop", "cancel", "unblock", "remove", "off"):
        die("there is no way to stop a block early. That is the point.\n"
            "       'selfctl status' shows how long is left.")
    if cmd not in commands:
        die("unknown command %r. Run 'selfctl help'." % cmd)
    return commands[cmd](args) or 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.stderr.write("\n")
        sys.exit(130)
    except BrokenPipeError:
        sys.exit(0)
