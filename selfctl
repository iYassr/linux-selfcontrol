class RawTerminal(object):
    def __enter__(self):
        import termios
        import tty
        self.termios = termios
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd)
        sys.stdout.write("\x1b[?25l")
        return self

    def __exit__(self, *exc):
        self.termios.tcsetattr(self.fd, self.termios.TCSADRAIN, self.saved)
        sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()
        return False

    def key(self, timeout=None):
        ready, _, _ = select.select([self.fd], [], [], timeout)
        if not ready:
            return None
        data = os.read(self.fd, 16)
        return {b"\x1b[A": "up", b"\x1b[B": "down", b"\x1bOA": "up", b"\x1bOB": "down",
                b"\r": "enter", b"\n": "enter", b" ": "space", b"\x1b": "esc",
                b"\x03": "quit", b"\x04": "quit", b"k": "up", b"j": "down",
                b"q": "quit"}.get(data, data.decode("utf-8", "ignore"))


class Screen(object):
    """Redraws a block of lines in place."""

    def __init__(self):
        self.height = 0

    def draw(self, lines):
        out = ""
        if self.height:
            out += "\x1b[%dA" % self.height
        out += "\r\x1b[J" + "\n".join(lines) + "\n"
        sys.stdout.write(out)
        sys.stdout.flush()
        self.height = len(lines)


def banner():
    return ["", "  " + bold(c("1;36", "Linux SelfControl")) + dim("  v" + VERSION), ""]


def checklist_frame(title, items, cursor, chosen, hint):
    lines = banner() + ["  " + bold(title), ""]
    for i, (key, label, note) in enumerate(items):
        pointer = cyan("❯") if i == cursor else " "
        box = green("[✔]") if key in chosen else dim("[ ]")
        text = "%-22s" % label
        lines.append("  %s %s %s %s" % (pointer, box, bold(text) if i == cursor else text, dim(note)))
    lines += ["", "  " + dim(hint), ""]
    return lines


def choice_frame(title, options, cursor, hint):
    lines = banner() + ["  " + bold(title), ""]
    for i, (_, label) in enumerate(options):
        pointer = cyan("❯") if i == cursor else " "
        lines.append("  %s %s" % (pointer, bold(label) if i == cursor else label))
    lines += ["", "  " + dim(hint), ""]
    return lines


def pick_many(title, items, chosen):
    cursor, chosen, screen = 0, set(chosen), Screen()
    hint = "↑/↓ move   space select   a all   enter continue   q quit"
    with RawTerminal() as term:
        while True:
            screen.draw(checklist_frame(title, items, cursor, chosen, hint))
            key = term.key()
            if key == "up":
                cursor = (cursor - 1) % len(items)
            elif key == "down":
                cursor = (cursor + 1) % len(items)
            elif key == "space":
                chosen ^= {items[cursor][0]}
            elif key == "a":
                keys = set(k for k, _, _ in items)
                chosen = set() if chosen == keys else keys
            elif key == "enter":
                return [k for k, _, _ in items if k in chosen]
            elif key in ("quit", "esc"):
                return None


def pick_one(title, options, cursor=0):
    screen = Screen()
    hint = "↑/↓ move   enter select   q quit"
    with RawTerminal() as term:
        while True:
            screen.draw(choice_frame(title, options, cursor, hint))
            key = term.key()
            if key == "up":
                cursor = (cursor - 1) % len(options)
            elif key == "down":
                cursor = (cursor + 1) % len(options)
            elif key == "enter":
                return options[cursor][0]
            elif key in ("quit", "esc"):
                return None


def ask(prompt):
    try:
        return input("  " + prompt).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return ""


def confirm_lines(names, extra, hostnames, seconds):
    what = ", ".join(names + extra) or "custom sites"
    ends = time.strftime("%a %H:%M", time.localtime(time.time() + seconds))
    return [
        "",
        "  " + bold("About to block"),
        "",
        "  " + dim("what      ") + what,
        "  " + dim("hostnames ") + str(len(hostnames)),
        "  " + dim("for       ") + bold(fmt_duration(seconds)) + dim("   until ≈ " + ends),
        "",
        "  " + yellow("There is no stop button.") + " Once it starts you cannot cancel it,",
        "  shorten it, or remove a site until the time is up.",
        "",
    ]


def _last_path():
    return os.path.join(config_dir(), "last.json")


def load_last():
    try:
        with open(_last_path()) as fh:
            data = json.load(fh)
        return [str(x) for x in data.get("lists", [])], str(data.get("duration", "1h"))
    except (OSError, ValueError, AttributeError):
        return ["social"], "1h"


def save_last(names, duration_text):
    if os.geteuid() == 0:
        return
    try:
        os.makedirs(config_dir(), exist_ok=True)
        with open(_last_path(), "w") as fh:
            json.dump({"lists": names, "duration": duration_text}, fh)
    except OSError:
        pass


DURATION_CHOICES = [("25m", "25 minutes"), ("50m", "50 minutes"), ("1h", "1 hour"),
                    ("2h", "2 hours"), ("4h", "4 hours"), ("8h", "8 hours"),
                    ("1d", "24 hours"), ("custom", "Custom…")]


def interactive_start():
    lists = available_lists()
    last_names, last_duration = load_last()
    items = [(n, lists[n]["title"], "%d sites" % len(lists[n]["domains"])) for n in sorted(lists)]
    items.append(("+custom", "Other sites…", "type your own"))
    picked = pick_many("What do you want to block?", items,
                       [n for n in last_names if n in lists])
    if picked is None:
        return 0
    tokens = [p for p in picked if p != "+custom"]
    if "+custom" in picked:
        typed = ask("Sites to block (space separated): ")
        tokens += typed.replace(",", " ").split()
    if not tokens:
        print("  Nothing selected.")
        return 0
    keys = [k for k, _ in DURATION_CHOICES]
    start_at = keys.index(last_duration) if last_duration in keys else 2
    duration_text = pick_one("For how long?", DURATION_CHOICES, start_at)
    if duration_text is None:
        return 0
    if duration_text == "custom":
        duration_text = ask("Duration (e.g. 45m, 3h, 1h30m, 2d): ")
    return start_block(duration_text, tokens, assume_yes=False)


def interactive_active(state):
    screen = Screen()
    hint = "a add sites   e extend   q quit"
    report, checked = protection_report(state), time.time()
    with RawTerminal() as term:
        while True:
            state = load_state()
            if state is None or remaining_now(state) <= 0:
                screen.draw(banner() + ["  " + green("✔ ") + bold("Block finished. Welcome back."), ""])
                return 0
            if time.time() - checked > 10:
                report, checked = protection_report(state), time.time()
            screen.draw(banner()[:-1] + status_lines(state, report) + ["  " + dim(hint), ""])
            key = term.key(1)
            if key in ("quit", "esc"):
                return 0
            if key in ("a", "e"):
                break
    if key == "a":
        typed = ask("Lists or sites to add: ")
        return cmd_add(typed.replace(",", " ").split()) if typed else 0
    typed = ask("Extend by (e.g. 30m, 1h): ")
    return cmd_extend([typed]) if typed else 0


