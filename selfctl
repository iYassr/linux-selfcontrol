def unit_texts():
    return {
        SERVICE: """[Unit]
Description=Linux SelfControl - enforces the active website block
Documentation=%(url)s
ConditionPathExists=/var/lib/linux-selfcontrol/state.json
RefuseManualStop=yes
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%(self)s _daemon
Restart=on-failure
RestartSec=1
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
""" % {"url": PROJECT_URL, "self": SELF},
        WATCHDOG: """[Unit]
Description=Linux SelfControl - watchdog
Documentation=%(url)s

[Service]
Type=oneshot
ExecStart=%(self)s _watchdog
NoNewPrivileges=yes
ProtectHome=yes
