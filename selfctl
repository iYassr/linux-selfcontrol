# Low-level system helpers
# --------------------------------------------------------------------------

_LONG = struct.calcsize("l")
FS_IOC_GETFLAGS = 0x80086601 if _LONG == 8 else 0x80046601
FS_IOC_SETFLAGS = 0x40086602 if _LONG == 8 else 0x40046602
FS_IMMUTABLE_FL = 0x00000010


def get_immutable(path):
    """True / False, or None when the filesystem has no immutable flag."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        buf = bytearray(8)
        fcntl.ioctl(fd, FS_IOC_GETFLAGS, buf)
        return bool(struct.unpack("i", bytes(buf[:4]))[0] & FS_IMMUTABLE_FL)
    except OSError:
        return None
    finally:
        os.close(fd)


def in_container():
    return os.path.exists("/.dockerenv") or os.path.exists("/run/.containerenv")


def set_immutable(path, on):
    """Set or clear the immutable flag. Returns True when it worked."""
    if on and in_container():
        return False      # a locked file would stop the runtime deleting the container
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        buf = bytearray(8)
        fcntl.ioctl(fd, FS_IOC_GETFLAGS, buf)
        flags = struct.unpack("i", bytes(buf[:4]))[0]
        new = flags | FS_IMMUTABLE_FL if on else flags & ~FS_IMMUTABLE_FL
        if new != flags:
            fcntl.ioctl(fd, FS_IOC_SETFLAGS, struct.pack("i", new) + b"\0" * 4)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


def atomic_write(path, text, mode=0o644):
    """Replace a file atomically, keeping owner, mode and security labels.

    Falls back to writing in place when the file cannot be renamed over
    (for example /etc/hosts bind-mounted into a container).
    """
    data = text.encode("utf-8", "surrogateescape")
    directory = os.path.dirname(path)
    tmp = os.path.join(directory, ".%s.selfctl-tmp" % os.path.basename(path))
    old = None
    try:
        old = os.stat(path)
    except OSError:
        pass
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, data)
            if old is not None:
                os.fchmod(fd, old.st_mode & 0o7777)
                try:
                    os.fchown(fd, old.st_uid, old.st_gid)
                except OSError:
                    pass
                for attr in ("security.selinux",):
                    try:
                        os.setxattr(fd, attr, os.getxattr(path, attr))
                    except (OSError, AttributeError):
                        pass
            else:
                os.fchmod(fd, mode)
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        with open(path, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())


def boottime():
    try:
        return time.clock_gettime(time.CLOCK_BOOTTIME)
    except (AttributeError, OSError):
        return time.monotonic()


def boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id") as fh:
            return fh.read().strip()
    except OSError:
        return "unknown"


def clock_synced():
    """True when the kernel says the clock is disciplined by NTP.

    The kernel raises STA_UNSYNC whenever the clock is set by hand, so a
    manual date change turns this off until a time server corrects it.
    """
    if os.environ.get("SELFCTL_CLOCK_SYNCED") is not None and SANDBOX:
        return os.environ["SELFCTL_CLOCK_SYNCED"] == "1"
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        buf = ctypes.create_string_buffer(512)
        result = libc.adjtimex(buf)
        return result not in (-1, 5)   # 5 == TIME_ERROR (unsynchronised)
    except Exception:
        return False


def run(cmd, timeout=15):
    """Run a helper command quietly; never raises."""
    try:
        return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              stdin=subprocess.DEVNULL, timeout=timeout).returncode
    except (OSError, subprocess.SubprocessError):
        return 127


def has_systemd():
    return (not SANDBOX and os.path.isdir("/run/systemd/system")
            and shutil.which("systemctl") is not None)


def flush_dns():
    if SANDBOX:
        return
    if shutil.which("resolvectl"):
        run(["resolvectl", "flush-caches"], 5)
    if shutil.which("nscd"):
        run(["nscd", "-i", "hosts"], 5)
    if shutil.which("pkill"):
        run(["pkill", "-HUP", "-x", "dnsmasq"], 5)


class locked(object):
    """Context manager around flock()."""

    def __init__(self, path, blocking=True):
        self.path, self.blocking, self.fd = path, blocking, None

    def __enter__(self):
        self.fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | (0 if self.blocking else fcntl.LOCK_NB))
        except OSError:
            os.close(self.fd)
            self.fd = None
            raise
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)
        return False


# --------------------------------------------------------------------------
# /etc/hosts
# --------------------------------------------------------------------------

_MANAGED_LINE_RE = re.compile(r"^(0\.0\.0\.0|::)\s+\S+$")


def strip_managed(text):
    """Remove our block and re-enable lines we commented out."""
    out, inside = [], False
    for line in text.splitlines():
        if line.strip() == BEGIN:
            inside = True
            if out and out[-1] == "":
                out.pop()
            continue
        if inside:
            if line.strip() == END:
                inside = False
                continue
            if _MANAGED_LINE_RE.match(line.strip()) or line.strip().startswith("# selfctl"):
                continue
            inside = False           # block was cut short by hand; keep the rest
        if line.startswith(DISABLED):
            line = line[len(DISABLED):]
        out.append(line)
    return "\n".join(out) + "\n" if out else ""


def compose_hosts(text, domains):
    """Return the hosts file content that enforces `domains`."""
    blocked = set(domains)
    lines = []
    for line in strip_managed(text).splitlines():
        body = line.split("#", 1)[0].split()
        # A foreign entry for a blocked name would win over ours; park it.
        if len(body) >= 2 and any(n.lower() in blocked for n in body[1:]):
            line = DISABLED + line
        lines.append(line)
    while lines and lines[-1] == "":
        lines.pop()
    block = [BEGIN, "# selfctl: %d hostnames. Run 'selfctl status' for details." % len(blocked)]
    for d in sorted(blocked):
        block.append("0.0.0.0 " + d)
        block.append(":: " + d)
    block.append(END)
    return "\n".join(lines + [""] + block) + "\n"


def read_hosts():
    try:
        with open(HOSTS, encoding="utf-8", errors="surrogateescape") as fh:
            return fh.read()
    except OSError:
        return ""


def write_hosts(text, immutable):
    set_immutable(HOSTS, False)
    atomic_write(HOSTS, text)
    if immutable:
        set_immutable(HOSTS, True)


def enforce_hosts(domains):
    """Make /etc/hosts carry the block. Returns True if it had to be fixed."""
    current = read_hosts()
    wanted = compose_hosts(current, domains)
    changed = current != wanted
    if changed:
        write_hosts(wanted, True)
        flush_dns()
    elif get_immutable(HOSTS) is False:
        set_immutable(HOSTS, True)
    return changed


