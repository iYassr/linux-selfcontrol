# Maintainer: Yasser <iYassr on GitHub>
pkgname=linux-selfcontrol
pkgver=0.1.0
pkgrel=1
pkgdesc="Block distracting websites for a set time, with no way to stop early"
arch=('any')
url="https://github.com/iYassr/linux-selfcontrol"
license=('MIT')
depends=('python')
optdepends=('e2fsprogs: lock /etc/hosts with the immutable flag')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
  cd "$pkgname-$pkgver"
  python3 -B -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  PREFIX=/usr DESTDIR="$pkgdir" sh install.sh
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
